# Copy to backend/.env for local development:  cp .env.example backend/.env
# Never commit real values. In hosted environments set these from a secret store (e.g. Key Vault).

# development | test | production   (production refuses to start without AUTH_MODE=entra)
APP_ENV=development
DATABASE_URL=postgresql+psycopg://cac:cac_local_dev@localhost:5432/cac_dev
TEST_DATABASE_URL=postgresql+psycopg://cac:cac_local_dev@localhost:5432/cac_test

# Authentication: "demo" (explicit demo mode, user switcher; never in production) or "entra".
# Leaving it empty makes the API reject every request (fail closed).
AUTH_MODE=demo

# Microsoft Entra ID (scaffolded; see docs/INTEGRATION_CHECKLIST.md)
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=
ENTRA_API_SCOPE=

# Optional server-side AI adapter. "none" = deterministic templates only.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=20

# Data import
# Imports declaring data_classification=live are refused unless this is true (only after approval).
ALLOW_LIVE_IMPORT=false
# Folder watched by the scheduler; each sub-folder is one import package.
IMPORT_INBOX=
SCHEDULER_INTERVAL_MINUTES=60

# Comma-separated origins if the SPA is served from another host (empty = same origin only)
CORS_ORIGINS=
